{
    "modules-left": ["custom/power", "hyprland/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": ["tray", "pulseaudio", "bluetooth", "network", "battery", "clock"],
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "tray": {
        "spacing": 10
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "interval": 1,
        "player-icons": {
            "default": ""
        },
        "status-icons": {
            "paused": ""
        },
        "dynamic-order": ["title", "artist"]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} 󰂯 {volume}%",
        "format-muted": "{icon} Muted",
        "format-icons": {
            "headphone": "",
            "speaker": "󰓃"
        },
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲 disabled",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "on-click": "flatpak run io.github.kaii_lb.Overskride"
    },
    "network": {
        "family": "ipv4_6",
        "format": "{ifname}",
        "format-ethernet": "󰈀",
        "format-wifi": "󰖩",
        "format-linked": "󰛵 Linked (No IP)",
        "format-disconnected": "󰲛 Disconnected",
        "format-disabled": "󰅛 Disabled",
        "tooltip": true,
        "tooltip-format": "{ifname} / SSID: {essid} / IP Addresses: {ipaddr} ",
        "on-click": "nmgui"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "full-at": 99,
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock": {
        "format": "{:%Y/%m/%d (%a) %H:%M}",
        "on-click": "swaync-client -t -sw"
    }
}
